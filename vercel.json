{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{data/**,firebase-applet-config.json}",
      "maxDuration": 300
    },
    "api/run_python.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/run_python",
      "destination": "/api/run_python"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
